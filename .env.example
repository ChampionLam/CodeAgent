# CodeAgent 密钥示例 —— 复制成 .env 后再填值（.env 不进仓库，只有这份示例进）
#
# config.json 里只写变量**名**（例如 "apiKeyEnv": "OPENROUTER_API_KEY"），
# 真正的值从环境读：界面上不回读、不显示、不写日志。

# OpenAI 官方
OPENAI_API_KEY=
# DeepSeek 官方
DEEPSEEK_API_KEY=
# MiniMax（国内站 api.minimaxi.com）
MINIMAX_CN_API_KEY=
# MiniMax（国际站 api.minimax.io）
MINIMAX_INTL_API_KEY=
# 阿里云百炼（DashScope 兼容模式）
DASHSCOPE_API_KEY=
# 月之暗面 Kimi
MOONSHOT_API_KEY=
# 智谱 GLM
ZHIPU_API_KEY=
# 硅基流动
SILICONFLOW_API_KEY=
# OpenRouter
OPENROUTER_API_KEY=
# 自建 / 中转的 OpenAI 兼容端点
CUSTOM_API_KEY=
# 本地 Ollama（可留空）
OLLAMA_API_KEY=
